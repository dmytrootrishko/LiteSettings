<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
	<!-- Legacy\ holds the original ProgramSettings sources. They call DPAPI, which is Windows-only;
	     the tests never reach that code, so the platform warning is switched off. -->
	<NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
	<!-- Needed only to compile the original sources in Legacy\. -->
	<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteSettings.Xml\LiteSettings.Xml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
	<None Update="Fixtures\*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>