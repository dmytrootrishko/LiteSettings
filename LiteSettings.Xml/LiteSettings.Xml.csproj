<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>DOtrishko.LiteSettings.Xml</PackageId>
    <Title>DOtrishko.LiteSettings.Xml</Title>
    <Version>1.0.0</Version>
    <Authors>Dmytro Otrishko</Authors>
    <Description>XML format for LiteSettings. Stores [Save] properties in settings.xml under the user’s local application data folder. Install this package to get started, it includes the core LiteSettings library.</Description>
    <PackageProjectUrl>https://github.com/dmytrootrishko/LiteSettings</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dmytrootrishko/LiteSettings</RepositoryUrl>
    <PackageTags>settings;configuration;persistence;user-settings</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Internal\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteSettings\LiteSettings.csproj" />
  </ItemGroup>

</Project>
